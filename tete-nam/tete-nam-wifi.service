[Unit]
Description=Tete NAM - Wi-Fi de secours (hotspot si aucun Wi-Fi connu)
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
# « exec » et non « oneshot » : l'attente du Wi-Fi (jusqu'à 45 s) ne retarde
# plus la fin du démarrage vue par systemd (systemd-analyze reste lisible)
Type=exec
RemainAfterExit=yes
ExecStart=/opt/tete-nam/wifi-secours.sh auto
# Priorité basse : ne jamais gêner l'audio
Nice=15
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
