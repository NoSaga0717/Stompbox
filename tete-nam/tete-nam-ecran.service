[Unit]
Description=Tete NAM - interface tactile sur l'ecran de la tete
After=tete-nam-web.service systemd-user-sessions.service plymouth-start.service
# Comme un gestionnaire de connexion : c'est nous qui fermons le logo de
# démarrage (Plymouth), au moment où l'interface prend l'écran
Conflicts=plymouth-quit.service
After=plymouth-quit.service
Wants=tete-nam-web.service
# L'écran remplace la console texte sur tty1
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
Type=simple
User=__USER__
# Session de connexion sur tty1 (fichier /etc/pam.d/tete-nam-ecran) : donne
# accès à l'écran tactile et au processeur graphique
PAMName=tete-nam-ecran
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
# On n'attend plus la page web : le navigateur démarre tout de suite sur une
# page d'attente locale qui reprend le logo (voir ecran.sh). Le logo reste à
# l'écran jusqu'à ce que le navigateur s'affiche par-dessus.
ExecStartPre=-+/usr/bin/plymouth quit --retain-splash
ExecStart=/opt/tete-nam/ecran.sh
Restart=always
RestartSec=3
# Priorité basse : l'affichage ne doit jamais gêner l'audio
Nice=10

[Install]
WantedBy=multi-user.target
